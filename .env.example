# VoxCore environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.

# --- Core ---
# Refuses to start if this is empty or equals any placeholder. Generate with:
#   python -m voxcore.cli gen-secret
JWT_SECRET_KEY=REPLACE_ME_OR_REFUSE_TO_START
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list. Defaults to localhost dev origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# SQLite for dev, PostgreSQL recommended for production.
DATABASE_URL=sqlite:///./voxcore.db

# --- Rate limiting ---
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_DURATION_SECONDS=900

# --- ASR providers (enable only what you use) ---
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# --- LLM providers ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# --- Runtime ---
VOXCORE_HOST=0.0.0.0
VOXCORE_PORT=8000
VOXCORE_LOG_LEVEL=INFO
